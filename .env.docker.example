# Copy to `.env` in the repo root — docker compose reads it for the prod stack.
# (MONGODB_URI is NOT here; the compose file points the app at the bundled Mongo.)

# Clerk — same publishable key used in two places (build-time for the SPA, runtime for the API)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# App
ADMIN_EMAIL=you@example.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
