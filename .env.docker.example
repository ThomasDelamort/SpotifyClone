# Copy to `.env` in the repo root. Docker Compose reads it automatically.
# Only the PROD stack needs this file — the dev stack reads backend/.env and
# frontend/.env.local instead.

# ---- Clerk ----
# Same publishable key in two places: baked into the SPA at build time, and read
# by the API at runtime. Changing VITE_* requires a rebuild (`up --build`).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# ---- App ----
ADMIN_EMAIL=you@example.com

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---- Database ----
# Leave unset to use the bundled Mongo (requires `--profile local-db`), or set
# your Atlas connection string to run without a database container.
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/spotify_db

# ---- Optional overrides ----
# Host port for the site (default 8080 in prod, 3000 in dev).
# WEB_PORT=8080
# MongoDB 5+ requires a CPU with AVX. On older hardware mongo:7 crashes with
# exit 132 — pin the last AVX-free release instead.
# MONGO_TAG=4.4
