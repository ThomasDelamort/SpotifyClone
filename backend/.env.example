# ---- server ----
PORT=5000# keep 5000 so it matches the axios baseURL + compose port mapping
NODE_ENV=development

# ---- database ----
# Bundled Docker MongoDB (the `mongo` service):
MONGODB_URI=mongodb://mongo:27017/spotify-clone
# ...or MongoDB Atlas (then you can delete the `mongo` service from docker-compose.yml):
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/spotify-clone

# ---- auth (Clerk) ----
ADMIN_EMAIL=you@example.com
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# ---- media (Cloudinary) ----
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
